#include<iostream>
#include<string>
#include<cstdlib>
using namespace std;
int main(){
	string s;
	while(cin>>s){
		if(s=="0") break;
		for(int i=0;i<s.length();i++){
			cout<<s[i];
		}
		int a1=0;
		int a2=0;
		for(int i=0;i<s.length();i+=2){
			a1+=(s[i]-'0');
		}
		for(int i=1;i<s.length();i+=2){
			a2+=(s[i]-'0');
		}
		int sum=abs(a1-a2);
		if(sum%11==0){
			cout<<" is a multiple of 11."<<endl;
		}else{
			cout<<" is not a multiple of 11."<<endl;
		}
	}
} 
