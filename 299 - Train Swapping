#include<iostream> 
#include<vector>
using namespace std;
int main(){
	int T;
	cin>>T;
	while(T--){
		int t;
		cin>>t;
		vector<int> a(t);
		for(int i=0;i<t;i++){
			cin>>a[i];
		}
		int cnt=0;
		for(int i=0;i<t-1;i++){
			for(int j=i+1;j<t;j++){
				if(a[i]>a[j]){
					int temp=a[i];
					a[i]=a[j];
					a[j]=temp;
					cnt++;
				}
			}
		}
		cout<<"Optimal train swapping takes "<<cnt<<" swaps."<<endl;
	} 
}
