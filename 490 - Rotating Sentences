#include<iostream>
#include<string>
using namespace std;
int main(){
	string s[105];
	int k=0;
	int maxlen=0;
	while(getline(cin,s[k])){
		if(s[k].length()>maxlen){
			maxlen=s[k].length();
		}
		k++;
	}
	for(int i=0;i<maxlen;i++){
		for(int j=k-1;j>=0;j--){
			if(i>=s[j].length()){
				cout<<" ";
			}else{
				cout<<s[j][i];
			}
		}
		cout<<endl;
	} 
}
