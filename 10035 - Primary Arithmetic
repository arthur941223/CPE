#include<iostream>
using namespace std;
int main(){
	long long a,b;
	while(cin>>a>>b){
		if(a==0&&b==0) break; 
		int cnt=0;
		int plus=0;
		while(a>0||b>0){
			int temp=a%10+b%10+plus;
			if(temp>=10){
				cnt+=1;
				plus=1;
			}else{
				plus=0;
			}
			a/=10;
			b/=10;
		}
		if(cnt==0){
			cout<<"No carry operation."<<endl;
		}else if(cnt==1){
			cout<<"1 carry operation."<<endl;
		}else{
			cout<<cnt<<" carry operations."<<endl;
		}
	}
	
} 
