#include<iostream>
#include<vector>
#include<algorithm>
using namespace std;
int main(){
	int T;
	while(cin>>T){
		vector<int> a(T);
		for(int i=0;i<T;i++){
			cin>>a[i];
		}
		sort(a.begin(),a.end());
		int mid1,mid2;
		mid1=a[(T-1)/2];			//不是T/2 
		cout<<mid1<<" ";
		int cnt=0;
		if(T%2==0){
			mid2=a[T/2];			//不是(T+1)/2 
			for(int i=mid1;i<=mid2;i++){
				for(int j=0;j<T;j++){
					if(i==a[j]){
						cnt++;
					}
				}
			}
			int sum=mid2-mid1+1;
			cout<<cnt<<" "<<sum<<endl;
		}else{
			for(int j=0;j<T;j++){
				if(mid1==a[j]){
					cnt++;
				}
			}
			cout<<cnt<<" 1"<<endl;
		}
	}
} 
