#include<iostream>
#include<vector>
using namespace std;
int Table[20005];
int main(){
	int T;
	int cnt=1;
	while(cin>>T){
		int tf=1;
		vector<int> a(T);
		for(int i=0;i<20005;i++){
			Table[i]=0;
		}
		for(int i=0;i<T;i++){
			cin>>a[i];
			if(a[i]==0){
				tf=0;
			}
		}
		for(int i=1;i<T;i++){
			if(a[i-1]>=a[i]){
				tf=0;
			}
		}
		for(int i=0;i<T;i++){
			for(int j=i;j<T;j++){
				if(Table[a[i]+a[j]]!=1){
					Table[a[i]+a[j]]=1;
				}else{
					tf=0;
					break;
				}
			}
			if(tf==0){
				break;
			} 
		}
		if(tf){
			cout<<"Case #"<<cnt<<": It is a B2-Sequence."<<endl;	
		}else{
			cout<<"Case #"<<cnt<<": It is not a B2-Sequence."<<endl;
		}
		cnt++;
		cout<<endl; 
	}
}
