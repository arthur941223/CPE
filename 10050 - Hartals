#include<iostream>
#include<vector>
using namespace std;
int main(){
	int T;
	cin>>T;
	while(T--){
		int D,P;
		cin>>D>>P;
		int n;
		vector<int> Table(D+1);
		for(int i=0;i<P;i++){
			cin>>n;
			for(int j=n;j<=D;j+=n){
				Table[j]=1;
			}
		}
		for(int i=1;i<=D;i++){
			if(i%7==6||i%7==0){
				Table[i]=0;
			}
		}
		int cnt=0;
		for(int i=1;i<=D;i++){
			if(Table[i]==1){
				cnt++;
			}
		}
		cout<<cnt<<endl;
	}
} 
