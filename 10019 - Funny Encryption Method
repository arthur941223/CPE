#include<iostream>
using namespace std;
int main(){
	int T;
	cin>>T;
	while(T--){
		int n;
		cin>>n;
		int n1=n;
		int cnt1=0;
		int cnt2=0;
		while(n){
			if(n%2==1) cnt1++;
			n/=2;
		}
		while(n1){
			int temp=n1%10;
			while(temp){
				if(temp%2==1) cnt2++;
				temp/=2;
			}
			n1/=10;
		}
		cout<<cnt1<<" "<<cnt2<<endl;
	}
}
