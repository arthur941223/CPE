#include<iostream>
#include<iomanip>
using namespace std;
void bangla(long long a){
	if(a/10000000>0){
		bangla(a/10000000);
		cout<<" kuti";
		a%=10000000;
	}
	if(a/100000>0){
		cout<<" "<<a/100000<<" lakh";
		a%=100000;
	}
	if(a/1000>0){
		cout<<" "<<a/1000<<" hajar";
		a%=1000;
	}
	if(a/100>0){
		cout<<" "<<a/100<<" shata";
		a%=100;
	}
	if(a>0){
		cout<<" "<<a;
	}
}

int main(){
	long long n;
	int t=1;
	while(cin>>n){
		cout<<setw(4)<<setfill(' ')<<t<<".";
		if(n==0){
			cout<<" 0";
		}else{
			bangla(n);
		}
		cout<<endl;
		t++;
	}
}
