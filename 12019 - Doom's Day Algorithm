#include<iostream>
#include<string> 
using namespace std;
// 1/1 saturday
int main(){
	int Month[13]={0,31,28,31,30,31,30,31,31,30,31,30,31};
	string Week[]={"Saturday","Sunday","Monday","Tuesday", "Wednesday", "Thursday","Friday"};
	int M,N,T;
	cin>>T;
	while(T--){
		cin>>M>>N;
		int D=0;
		for(int i=0;i<M;i++){
			D+=Month[i];
		}
		D=D+N;
		D=(D-1)%7;				//不能 D%7-1 
		cout<<Week[D]<<endl;
	}
}
