#include<iostream>
#include<string>
using namespace std;
int main(){
	string S="`1234567890-=qwertyuiop[]\\asdfghjkl;'zxcvbnm,./";
	string s;
	while(getline(cin,s)){
		for(int i=0;i<s.length();i++){
			if(s[i]>='A'&&s[i]<='Z'){
				s[i]=s[i]-'A'+'a';
			}
		}
		for(int i=0;i<s.length();i++){
			if(s[i]==' '){
				cout<<" "; 
			}else{
				for(int j=2;j<S.length();j++){
					if(s[i]==S[j]){
						cout<<S[j-2];
					}
				}
			}
		}
		cout<<endl;
	}
}
