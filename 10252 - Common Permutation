#include<iostream>
#include<string>
using namespace std;
int main(){
	string s1,s2;
	while(cin>>s1>>s2){
		int Table1[26]={0};
		int Table2[26]={0};
		for(int i=0;i<s1.length();i++){
			Table1[s1[i]-'a']++;
		}
		for(int i=0;i<s2.length();i++){
			Table2[s2[i]-'a']++;
		}
		for(int i=0;i<26;i++){
			while(Table1[i]>=1&&Table2[i]>=1){
				cout<<char(i+'a');
				Table1[i]--;
				Table2[i]--;
			}
		}
		cout<<endl;
	}
} 
