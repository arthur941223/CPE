#include<iostream>
#include<string>
using namespace std;
int funtion(int a);
int main(){
	string s;
	while(getline(cin,s)){
		if(s=="0"){
			break;
		}
		int cnt=1;
		int sum=0;
		for(int i=0;i<s.length();i++){
			cout<<s[i];
			sum+=s[i]-'0';
		}
		if(sum%9==0){
			while(sum!=9){
				sum=funtion(sum);
				cnt++;
			}
			cout<<" is a multiple of 9 and has 9-degree "<<cnt<<"."<<endl;
		}else{
			cout<<" is not a multiple of 9."<<endl;
		}
	}
}

int funtion(int a){
	int temp=0;
	while(a){
		temp+=a%10;
		a/=10;
	}
	return temp;
}
