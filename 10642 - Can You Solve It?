#include<iostream>
#include<cstdlib>
using namespace std;
int main(){
	int T;
	cin>>T;
	int t=1;
	while(T--){
		int x1,x2,y1,y2;
		cin>>x1>>y1>>x2>>y2;
		int temp1,temp2;
		int sum1=0;
		int sum2=0;
		temp1=x1+y1;
		temp2=x2+y2;
		for(int i=0;i<=temp1;i++){
			sum1+=i;
		}
		for(int i=0;i<=temp2;i++){
			sum2+=i;
		}
		sum1=sum1+x1;
		sum2=sum2+x2;
		int SUM=abs(sum2-sum1);
		cout<<"Case "<<t<<": "<<SUM<<endl;
		t++;
	} 
}
 
