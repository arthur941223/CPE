#include<iostream>
using namespace std;

int main(){
	int Table[501];
	Table[1]=1;
	Table[2]=2;
	for(int i=3;i<=45;i++){
		Table[i]=Table[i-1]+Table[i-2];
	}
	int T;
	cin>>T;
	while(T--){
		int n;
		cin>>n;
		cout<<n<<" = ";
		bool tf=false;
		if(n==1){
			cout<<1<<" (fib)"<<endl;
		}else{
			for(int i=45;i>0;i--){
				if(n>=Table[i]){
					n-=Table[i];
					cout<<"1";
					tf=true;
				}else if(tf){
					cout<<"0";
				}
			}
			cout<<" (fib)"<<endl; 
		}
	}
} 

