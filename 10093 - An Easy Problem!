#include<iostream>
#include<string>
using namespace std;
int main(){
	string s;
	while(getline(cin,s)){
		int max=1;                        	//最低是2進位 
		int sum=0;
		int temp;
		for(int i=0;i<s.length();i++){
			if(s[i]>='0'&&s[i]<='9'){
				temp=s[i]-'0';
			}else if(s[i]>='A'&&s[i]<='Z'){
				temp=s[i]-'A'+10;
			}else if(s[i]>='a'&&s[i]<='z'){
				temp=s[i]-'a'+36;
			}else{
				continue;
			}
			if(max<temp){
				max=temp;
			}
			sum+=temp;
		}
		for(int i=max;i<62;i++){
			if(sum%i==0){
				cout<<i+1<<endl;
				break;
			}else if(i==61){
				cout<<"such number is impossible!"<<endl;
			}else{
				continue;
			}
		}
	}
} 
