#include<iostream>
#include<cmath>
using namespace std;
int main(){
	int a,b;
	while(cin>>a>>b){
		if(a==0&&b==0){
			break;
		}
		int cnt=0;
		int tf=0;
		int x=sqrt(a);
		if(x*x==a){
			tf=1;
		}
		if(tf==1){
			for(int i=sqrt(a);i<=sqrt(b);i++){
				cnt++;
			}
		}else{
			for(int i=sqrt(a)+1;i<=sqrt(b);i++){
				cnt++;
			}
		}
		cout<<cnt<<endl;
	}
}
