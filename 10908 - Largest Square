#include<iostream>
#include<string>
#include<vector>
using namespace std;
int main(){
	int T;
	cin>>T;
	while(T--){
		int M,N,Q;
		cin>>M>>N>>Q;
		cout<<M<<" "<<N<<" "<<Q<<endl;
		vector<string> s(M);
		for(int i=0;i<M;i++){
			cin>>s[i];
		}
		int a,b;
		for(int i=0;i<Q;i++){
			cin>>a>>b;
			bool tf=true;
			int k=1;
			while(tf){
				if(a+k>=M||a-k<0||b+k>=N||b-k<0){
					tf=false;
					break;
				}
				for(int y=a-k;y<=a+k;y++){
					for(int x=b-k;x<=b+k;x++){
						if(s[a][b]!=s[y][x]){
							tf=false;
							break;
						}
					}
				}
				if(tf){
					k++;
				} 
			}
			cout<<2*k-1<<endl;
		}
	}
}
